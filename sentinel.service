[Unit]
Description=Sentinel - unscheduled material-events monitor (Sundew sibling)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Set for Amazon Linux (EC2). Adjust User/paths if you install elsewhere.
User=ec2-user
WorkingDirectory=/home/ec2-user/sundew
ExecStart=/usr/bin/python3 /home/ec2-user/sundew/sentinel.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
