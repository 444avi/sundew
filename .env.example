# Sundew configuration — copy to .env (which is gitignored) and fill in.
# Sundew loads this file itself; no python-dotenv needed.

# --- Anthropic (required unless you run with --no-classify) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Finnhub (Sentinel market-cap gate) ---
# Free key from https://finnhub.io/register. Sentinel only notifies about
# companies at/above sentinel_config.MARKET_CAP_MIN_USD ($1B). Without this
# key the gate is fail-open (every company passes); set it to enforce the
# floor. Set MARKET_CAP_ENABLED=False in sentinel_config.py to disable entirely.
FINNHUB_API_KEY=

# --- Email (required unless you run with --no-email) ---
# EMAIL_FROM must be an address on the verified sending domain
# (arboretuminvestments.net). sundew + sentinel send as sundew@.
EMAIL_FROM=sundew@arboretuminvestments.net
# Replies land here (a real, monitored inbox); the From is send-only.
EMAIL_REPLY_TO=avi@arboretuminvestments.net
#
# Delivery has two backends, chosen automatically (see sesmail.py):
#
#   1) SMTP (Mailtrap) -- used when SMTP_HOST is set. This is the current
#      production path. Get these from Mailtrap: Sending -> your domain ->
#      Integrations -> SMTP. Keep SMTP_PASSWORD out of version control.
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
#
#   2) Amazon SES (fallback) -- used only when SMTP_HOST is empty. Auth is the
#      EC2 instance role (no password). Leave these as-is; they are ignored
#      while SMTP_HOST is set.
AWS_REGION=us-west-1
SES_CONFIGURATION_SET=arboretum-notifications

# --- Slack (optional; operator mirror, client routes, ops notices) ---
# Incoming-webhook URL per channel (#sundew, #sentinel). Each URL is a secret:
# anyone holding it can post to the channel, so keep it next to SMTP_PASSWORD.
# Only https://hooks.slack.com/services/ URLs are accepted; anything else is
# ignored. Unset = no Slack posts. Email stays the system of record: Slack posts
# only after a delivery is recorded sent, and never affects retries.
SLACK_WEBHOOK_URL_SUNDEW=
SLACK_WEBHOOK_URL_SENTINEL=
# Comma-separated recipients whose notifications are mirrored to the channel
# (the operator's own addresses). Unset mirrors nothing. Ops notices (a delivery
# that failed its final attempt) carry ids and exception types only and post
# whenever the webhook is set.
SLACK_MIRROR_EMAILS=
# Optional: send ops notices for both monitors here instead of the webhooks
# above. Ops notices never go to a client route.
SLACK_OPS_WEBHOOK_URL=
# Client routes: one line per client per monitor, monitor first, then any name:
#   SLACK_ROUTE_SUNDEW_<NAME>=<email>[,<email>...]|<webhook URL>
#   SLACK_ROUTE_SENTINEL_<NAME>=<email>[,<email>...]|<webhook URL>
# A delivery to a listed address is mirrored to that client's webhook (and to
# every other route listing it). Keep client addresses out of
# SLACK_MIRROR_EMAILS, or their notifications also post to the operator's
# channel. A malformed line is skipped with a warning naming the variable.
# Test with: delivery_worker.py --test-slack sundew --route ACME
# SLACK_ROUTE_SUNDEW_ACME=alice@acme.example.com,bob@acme.example.com|https://hooks.slack.com/services/...
# SLACK_ROUTE_SENTINEL_ACME=alice@acme.example.com|https://hooks.slack.com/services/...

# Sentinel source-health warnings are operational and never use subscriber
# delivery. Set a separate administrator address for those warnings.
ADMIN_EMAIL_TO=ops@example.com

# --- User notification settings ---------------------------------------------
# Used only when legacy recipients are first seeded into app.db. Each user can
# change their IANA timezone later in the settings UI.
APP_DEFAULT_TIMEZONE=America/Los_Angeles

# Base URL appended to notification emails for manage/unsubscribe links. The
# settings service listens on loopback by default; expose it only through your
# operator-controlled tunnel or reverse proxy.
SETTINGS_PUBLIC_URL=http://localhost:8787

# --- Recipient lists ---------------------------------------------------------
# Legacy migration inputs. On first startup they seed verified users and
# defaults into app.db; after that, saved settings are authoritative and these
# values do not overwrite user choices. Each may be comma-separated.
#
#   EMAIL_TO       -> the shared "everyone" list. SENTINEL emails this list, and
#                     plain Sundew FALLS BACK to it when EMAIL_TO_SUNDEW is unset.
#   EMAIL_TO_SUNDEW  -> plain-Sundew subset (no Kalshi section). Optional; if unset,
#                     plain Sundew goes to EMAIL_TO.
#   EMAIL_TO_KS    -> Sundew.ks subset (gets the "Relevant Kalshi markets" copy).
#                     Optional; if unset, no second copy is sent at all.
#
# The plain Sundew email and the Sundew.ks email are two independent messages, so
# keep EMAIL_TO_SUNDEW and EMAIL_TO_KS disjoint — nobody should be on both.
#
# For "everyone gets Sentinel; each person gets sundew OR sundew.ks":
#   EMAIL_TO      = everyone            (Sentinel; = union of the two below)
#   EMAIL_TO_SUNDEW = the plain-only folk
#   EMAIL_TO_KS   = the Kalshi folk
#
# For the original single-list behavior, just set EMAIL_TO and leave the other
# two empty: Sentinel and plain Sundew both go to EMAIL_TO, no Kalshi copy.
EMAIL_TO=you@gmail.com
EMAIL_TO_SUNDEW=
EMAIL_TO_KS=
