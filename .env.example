# Vavi configuration — copy to .env (which is gitignored) and fill in.
# Vavi loads this file itself; no python-dotenv needed.

# --- Anthropic (required unless you run with --no-classify) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Finnhub (Sentinel market-cap gate) ---
# Free key from https://finnhub.io/register. Sentinel only notifies about
# companies at/above sentinel_config.MARKET_CAP_MIN_USD ($1B). Without this
# key the gate is fail-open (every company passes); set it to enforce the
# floor. Set MARKET_CAP_ENABLED=False in sentinel_config.py to disable entirely.
FINNHUB_API_KEY=

# --- Email / Amazon SES (required unless you run with --no-email) ---
# Mail is sent through Amazon SES using the EC2 instance role for auth, so
# there is NO SMTP password to set here. EMAIL_FROM must be an address on a
# verified SES identity (the arboretuminvestments.net domain). Region defaults
# to us-west-1; override with AWS_REGION if you ever send from another region.
EMAIL_FROM=alerts@arboretuminvestments.net
AWS_REGION=us-west-1
# SES configuration set: publishes bounces/complaints/deliveries to SNS for
# monitoring. Defaults to arboretum-notifications; set empty to disable.
SES_CONFIGURATION_SET=arboretum-notifications

# Sentinel source-health warnings are operational and never use subscriber
# delivery. Set a separate administrator address for those warnings.
ADMIN_EMAIL_TO=ops@example.com

# --- User notification settings ---------------------------------------------
# Used only when legacy recipients are first seeded into app.db. Each user can
# change their IANA timezone later in the settings UI.
APP_DEFAULT_TIMEZONE=America/Los_Angeles

# Base URL appended to notification emails for manage/unsubscribe links. The
# settings service listens on loopback by default; expose it only through your
# operator-controlled tunnel or reverse proxy.
SETTINGS_PUBLIC_URL=http://localhost:8787

# --- Recipient lists ---------------------------------------------------------
# Legacy migration inputs. On first startup they seed verified users and
# defaults into app.db; after that, saved settings are authoritative and these
# values do not overwrite user choices. Each may be comma-separated.
#
#   EMAIL_TO       -> the shared "everyone" list. SENTINEL emails this list, and
#                     plain Vavi FALLS BACK to it when EMAIL_TO_VAVI is unset.
#   EMAIL_TO_VAVI  -> plain-Vavi subset (no Kalshi section). Optional; if unset,
#                     plain Vavi goes to EMAIL_TO.
#   EMAIL_TO_KS    -> Vavi.ks subset (gets the "Relevant Kalshi markets" copy).
#                     Optional; if unset, no second copy is sent at all.
#
# The plain Vavi email and the Vavi.ks email are two independent messages, so
# keep EMAIL_TO_VAVI and EMAIL_TO_KS disjoint — nobody should be on both.
#
# For "everyone gets Sentinel; each person gets vavi OR vavi.ks":
#   EMAIL_TO      = everyone            (Sentinel; = union of the two below)
#   EMAIL_TO_VAVI = the plain-only folk
#   EMAIL_TO_KS   = the Kalshi folk
#
# For the original single-list behavior, just set EMAIL_TO and leave the other
# two empty: Sentinel and plain Vavi both go to EMAIL_TO, no Kalshi copy.
EMAIL_TO=you@gmail.com
EMAIL_TO_VAVI=
EMAIL_TO_KS=
