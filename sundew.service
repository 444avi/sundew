[Unit]
Description=Sundew - Trump Truth Social market-awareness monitor
After=network-online.target
Wants=network-online.target
# Don't hammer on repeated crashes.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Set for Amazon Linux (EC2). Adjust User/paths if you install elsewhere.
# Sundew is stdlib-only, so the system python3 is fine.
User=ec2-user
WorkingDirectory=/home/ec2-user/sundew
ExecStart=/usr/bin/python3 /home/ec2-user/sundew/sundew.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
